# Copy to .env and fill in. Never commit .env.
# LiveKit Cloud project (https://cloud.livekit.io): any project works.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Google AI Studio key for the Gemini model that makes Janus's decisions.
GEMINI_API_KEY=
# FDB's LLM judge (semantic argument matching + response quality).
OPENAI_API_KEY=
# Optional: which hosted services to use (see README "Keys").
# JANUS_LLM_PROVIDER=gemini   # or openai (then GEMINI_API_KEY is not needed)
# JANUS_STT=local             # or openai (hosted speech-to-text, uses OPENAI_API_KEY)
