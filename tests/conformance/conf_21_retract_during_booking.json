          "okay",
          "sure",
          "understood",
          "fine",
          "dropping",
          "leave it",
          "stopping",
          "cancel"
        ],
        "after_ms": 2500,
        "before_ms": 3700,
        "weight": 0.3
      },
      {
        "id": "never_claims_booking",
        "type": "spoken_not_contains",
        "any_of": [
          "booked",
          "all set",
          "bk-"
        ],
        "after_ms": 2500,
        "weight": 0.4
      }
    ],
    "recovery": {
      "interrupt_at_ms": 2500,
      "invalidated_calls": [
        {
          "tool": "book_flight",
